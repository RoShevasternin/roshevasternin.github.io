   },
   "vi": {
    "n": "Dâu tây",
    "a": "",
    "y": "",
    "f": "Dâu tây không phải quả mọng thật sự: mỗi “hạt” li ti trên nó là một quả riêng, bên trong có một hạt."
   },
   "tr": {
